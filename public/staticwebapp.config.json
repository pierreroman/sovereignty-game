{
  "routes": [
    { "route": "/api/myths", "methods": ["GET"], "allowedRoles": ["anonymous"] },
    { "route": "/api/myths", "methods": ["PUT"], "allowedRoles": ["anonymous"] },
    { "route": "/api/session", "methods": ["GET", "POST", "DELETE"], "allowedRoles": ["anonymous"] },
    { "route": "/.auth/*", "statusCode": 404 }
  ],
  "platform": { "apiRuntime": "node:22" },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "/.auth/*"]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
